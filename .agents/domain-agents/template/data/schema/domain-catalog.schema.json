{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "domains"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "manifestPath", "repositoryIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "title": { "type": "string", "minLength": 1 },
          "manifestPath": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]*$" },
          "repositoryIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" } }
        }
      }
    }
  }
}
