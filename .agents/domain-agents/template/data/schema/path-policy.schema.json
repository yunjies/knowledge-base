{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "domainId", "policyResourceIds", "readResourceIds", "writeTargets", "denyPathForms"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "domainId": { "type": "string", "minLength": 1 },
    "policyResourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "readResourceIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "writeTargets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "operations", "versionGuarded"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "operations": { "type": "array", "uniqueItems": true, "items": { "enum": ["create", "read", "update", "delete"] } },
          "versionGuarded": { "const": true }
        }
      }
    },
    "denyPathForms": { "type": "array", "uniqueItems": true, "items": { "enum": ["absolute", "parent-traversal", "symlink-outside-workspace", "unregistered-resource"] } }
  }
}
