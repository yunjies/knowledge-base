{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "domainId", "resources", "repositories", "operationMethods", "changeKinds"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "domainId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "title", "path", "format", "maxBytes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "kind": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "title": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\).+$" },
          "anchor": { "type": "string", "minLength": 1 },
          "format": { "const": "markdown" },
          "maxBytes": { "type": "integer", "minimum": 1, "maximum": 1000000 }
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "root", "readPaths", "denyPaths", "maxFileBytes", "maxLines"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "root": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\).+$" },
          "readPaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\).+$" } },
          "denyPaths": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\).+$" } },
          "maxFileBytes": { "type": "integer", "minimum": 1, "maximum": 1000000 },
          "maxLines": { "type": "integer", "minimum": 1, "maximum": 200 }
        }
      }
    },
    "operationMethods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "repositoryId", "methodId", "resourceIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "repositoryId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "methodId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "resourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    },
    "changeKinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "layers", "resourceIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
          "layers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["lint", "static", "live", "external"] } },
          "resourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    }
  }
}
