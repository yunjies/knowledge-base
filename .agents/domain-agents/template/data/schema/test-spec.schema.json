{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "domainId", "changeKinds"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "domainId": { "type": "string", "minLength": 1 },
    "changeKinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "layers", "resourceIds"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "layers": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["lint", "static", "live", "external"] } },
          "resourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
        }
      }
    }
  }
}
