{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "domainId", "workflowId", "startStage", "terminalStage", "stages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "domainId": { "type": "string", "minLength": 1 },
    "workflowId": { "type": "string", "minLength": 1 },
    "startStage": { "type": "string", "minLength": 1 },
    "terminalStage": { "type": "string", "minLength": 1 },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "resourceIds", "requiredResultFields", "fieldConstraints", "transitions"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "resourceIds": { "type": "array", "items": { "type": "string" } },
          "delegationOwner": { "enum": ["session-leader"] },
          "requiredResultFields": { "type": "array", "items": { "type": "string" } },
          "fieldConstraints": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type"],
              "properties": {
                "type": { "enum": ["string", "array", "object", "number", "integer", "boolean"] },
                "minLength": { "type": "integer", "minimum": 0 },
                "minItems": { "type": "integer", "minimum": 0 },
                "enum": { "type": "array", "minItems": 1 }
              }
            }
          },
          "transitions": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } }
        }
      }
    }
  }
}
