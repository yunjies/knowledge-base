      "methodId": "npm-test",
      "resourceIds": ["project-tests"]
    }
  ],
  "changeKinds": [
    {
      "id": "domain-knowledge",
      "layers": ["lint"],
      "resourceIds": ["feature-flow", "dsh-deployment", "domain-tests"]
